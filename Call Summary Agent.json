    {
      "parameters": {
        "jsCode": "const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst b64 = buf.toString('base64');\nconst hook = $('Webhook').first().json.body;\nconst mime = $input.first().binary.data.mimeType || 'audio/mpeg';\n\nconst prompt = `Bạn là trợ lý phân tích cuộc gọi chăm sóc khách hàng.\nHãy nghe file audio và trả về DUY NHẤT một JSON với các khóa:\n- transcript: toàn bộ lời thoại (ghi rõ người nói nếu phân biệt được)\n- language: mã ngôn ngữ, ví dụ \"vi\" hoặc \"en\"\n- summary: tóm tắt 2-4 câu bằng tiếng Việt\n- sentiment: \"positive\", \"neutral\" hoặc \"negative\"\n- keywords: mảng 3-6 từ khóa\n- action_items: mảng các object {task, owner, due_date}, due_date dạng YYYY-MM-DD hoặc null\nHôm nay là ${new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' })}. Nếu audio không có lời thoại, để transcript rỗng và summary ghi \"Không có lời thoại\".`;\n\nreturn [{\n  json: {\n    requestBody: {\n      contents: [{ parts: [\n        { inline_data: { mime_type: mime, data: b64 } },\n        { text: prompt },\n      ]}],\n      generationConfig: { responseMimeType: 'application/json' },\n    },\n  },\n}];"
      },
